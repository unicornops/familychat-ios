// Analytics and Diagnostics

import "package://pkg.pkl-lang.org/github.com/element-hq/pkl-tools/staticcode@1.1.0#/StaticCode.pkl"

rageshakeURL: String? = read?("env:RAGESHAKE_URL")
mapLibreAPIKey: String? = read?("env:MAPLIBRE_API_KEY")

output {
  renderer = new StaticCode.Renderer {
    language = "Swift"
    objectName = "Secrets"
    isolation = "nonisolated"
  }
}
